NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://stromblick:stromblick@localhost:5432/stromblick
TEST_DATABASE_URL=postgresql://stromblick:stromblick@localhost:5432/stromblick_test
# Generate with: openssl rand -hex 32
INGEST_SECRET=
# Minutes between self-started ingest runs; leave unset in development (ingest by hand instead).
# INGEST_INTERVAL_MINUTES=60
# Requests per minute and client address on the data routes (default 300).
# RATE_LIMIT_PER_MINUTE=300
# Google AI Studio key for the assistant (leave unset to switch the assistant off). Never commit it.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Production only: Neon's original URL for the Prisma CLI (keep sslmode=require).
# MIGRATE_DATABASE_URL=